{
    "description": "CSpell configuration for the shield module, based on the contrib default in gitlab_templates assets/.cspell.json. Some of the arrays are expanded in scripts/prepare-cspell.php. See https://project.pages.drupalcode.org/gitlab_templates/jobs/cspell/ for more details.",
    "language": "en-US",
    "allowCompoundWords": false,
    "globRoot": ".",
    "minWordLength": 4,
    "ignorePaths": [],
    "dictionaries": [],
    "dictionaryDefinitions": [],
    "words": [
        "facebookexternalhit",
        "keyuser",
        "Twitterbot",
        "nfacebookexternalhit"
    ],
    "flagWords": [
        "blacklist->blocklist, denylist",
        "blacklists->blocklists, denylists",
        "blacklist's->blocklist's, denylist's",
        "blacklisted->blocklisted, denylisted",
        "e-mail",
        "grey",
        "queuing",
        "whitelist:allowlist",
        "whitelists:allowlists",
        "whitelist's:allowlist's",
        "whitelisted:allowlisted"
    ],
    "overrides": [
        {
            "filename": "**/{*.engine,*.inc,*.install,*.module,*.profile,*.theme}",
            "languageId": "php"
        }
    ]
}
