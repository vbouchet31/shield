<?php

/**
 * @file
 * Contains install and update related functions for Shield.
 */

/**
 * Update allow_cli config to boolean value.
 */
function shield_update_8001() {
  $config = \Drupal::configFactory()->getEditable('shield.settings');
  $allow_cli = (bool) $config->get('allow_cli');
  $config->set('allow_cli', $allow_cli);
  $config->save();
}

/**
 * Convert user and pass config to credential provider config.
 */
function shield_update_8002() {
  // Read the currently effective values, not just the stored ones: sites
  // commonly keep the credentials out of exported config by overriding them in
  // settings.php. getEditable() ignores those overrides, so migrating from it
  // would silently drop the credentials and leave the site unprotected.
  $effective = \Drupal::configFactory()->get('shield.settings');
  $user = $effective->get('user');
  $pass = $effective->get('pass');

  $config = \Drupal::configFactory()->getEditable('shield.settings');
  $stored_user = $config->get('user');

  $config
    ->set('credential_provider', 'shield')
    ->set('credentials.shield.user', $user ?? '')
    ->set('credentials.shield.pass', $pass ?? '')
    ->clear('user')
    ->clear('pass')
    ->save();

  // The override in settings.php still targets the old keys, which no longer
  // exist. Tell the site owner to move it, and note that the credentials have
  // been copied into active config so that the site is not left unprotected.
  if (!empty($user) && empty($stored_user)) {
    return t('Shield credentials were being overridden in settings.php and have been copied into the shield.settings configuration so that the site is not left unprotected. Move the override to the credentials.shield.user and credentials.shield.pass keys, then clear the copied values from active configuration.');
  }
}

/**
 * Enable shield conditionally after shield_enable option was added.
 */
function shield_update_8003() {
  // Note: Get the currently effective value, instead of getEditable(), to make
  // sure not to leave a site unprotected if config overridden in settings.php.
  $config = \Drupal::configFactory()->get('shield.settings');

  // Shield is considered to be enabled if user value is not empty, find
  // the user value based on credential_provider.
  switch ($config->get('credential_provider')) {
    case 'shield':
      $user = $config->get('credentials.shield.user');
      break;

    case 'key':
      $user = $config->get('credentials.key.user');
      break;

    case 'multikey':
      $storage = \Drupal::entityTypeManager()->getStorage('key');
      $user_pass_key = $storage->load($config->get('credentials.multikey.user_pass_key'));
      if ($user_pass_key) {
        $values = $user_pass_key->getKeyValues();
        $user = $values['username'];
      }
      break;
  }

  if (!empty($user)) {
    $config = \Drupal::configFactory()->getEditable('shield.settings');
    $config->set('shield_enable', TRUE)->save();
  }
}

/**
 * Rename the legacy IP list setting to 'allowlist'.
 */
function shield_update_8004() {
  $config = \Drupal::configFactory()->getEditable('shield.settings');
  $config
    // cspell:disable-next-line
    ->set('allowlist', $config->get('whitelist'))
    // cspell:disable-next-line
    ->clear('whitelist')
    ->save();
}

/**
 * Set the default value of new configs for existing sites.
 */
function shield_update_8005() {
  $config = \Drupal::configFactory()->get('shield.settings');

  $editable = \Drupal::configFactory()->getEditable('shield.settings');
  if (is_null($config->get('domains'))) {
    $editable->set('domains', '');
  }
  if (is_null($config->get('method'))) {
    $editable->set('method', 0);
  }
  if (is_null($config->get('paths'))) {
    $editable->set('paths', '');
  }
  if (is_null($config->get('unset_basic_auth_headers'))) {
    $editable->set('unset_basic_auth_headers', TRUE);
  }
  $editable->save();
}

/**
 * Add the debug_header config.
 */
function shield_update_8006() {
  $config = \Drupal::configFactory()->get('shield.settings');

  if (is_null($config->get('debug_header'))) {
    \Drupal::configFactory()->getEditable('shield.settings')
      ->set('debug_header', FALSE)
      ->save();
  }
}

/**
 * Disable shield if the username is empty.
 */
function shield_update_8007() {
  $config = \Drupal::configFactory()->get('shield.settings');

  // If shield is enabled but the username is empty, disable shield.
  if ($config->get('shield_enable')
  && $config->get('credential_provider') === 'shield'
  && empty($config->get('credentials.shield.user'))) {
    \Drupal::configFactory()->getEditable('shield.settings')
      ->set('shield_enable', FALSE)
      ->save();
  }
}

/**
 * Update 'paths' variable if null, and remove unused 'path' variable.
 */
function shield_update_8008() {
  $editable = \Drupal::configFactory()->getEditable('shield.settings');
  if (is_null($editable->get('paths'))) {
    $editable->set('paths', '');
  }
  if ($editable->get('path') !== NULL) {
    $editable->clear('path')->save();
  }
}

/**
 * Recover credentials left behind by a stale settings.php override.
 */
function shield_update_8009() {
  // shield_update_8002() used to read the credentials without applying config
  // overrides, so sites that set 'user' and 'pass' in settings.php had them
  // dropped and were silently left unprotected. Those overrides still resolve
  // against the old keys, so an effective value there is a reliable marker.
  $effective = \Drupal::configFactory()->get('shield.settings');

  if ($effective->get('credential_provider') !== 'shield'
    || !empty($effective->get('credentials.shield.user'))
    || empty($effective->get('user'))) {
    return NULL;
  }

  \Drupal::configFactory()->getEditable('shield.settings')
    ->set('credentials.shield.user', $effective->get('user'))
    ->set('credentials.shield.pass', $effective->get('pass') ?? '')
    ->set('shield_enable', TRUE)
    ->save();

  return t('Shield credentials were still being overridden in settings.php under the removed user and pass keys, so the site was left unprotected. They have been copied into the shield.settings configuration and Shield has been re-enabled. Move the override to the credentials.shield.user and credentials.shield.pass keys, then clear the copied values from active configuration.');
}

/**
 * Add the user_agents config.
 */
function shield_update_8010() {
  $config = \Drupal::configFactory()->get('shield.settings');

  if (is_null($config->get('user_agents'))) {
    \Drupal::configFactory()->getEditable('shield.settings')
      ->set('user_agents', '')
      ->save(TRUE);
  }
}
